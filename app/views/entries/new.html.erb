<% content_for :title, "New entry -- Soliloquy" %>

<% if alert = flash[:alert] %>
  <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg inline-block"><%= alert %></p>
<% end %>

<h1 class="font-bold text-3xl mb-2">New entry</h1>
<p class="bg-white border border-orange-200 rounded-lg p-4 text-gray-700 mb-8">
  <span class="font-semibold text-orange-700">Today's prompt:</span> <%= @prompt %>
</p>

<div class="grid gap-6 md:grid-cols-3">
  <section class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="font-semibold mb-3">Type it out</h2>
    <%= form_with url: entries_path, method: :post do %>
      <textarea name="transcript" rows="8" required placeholder="What's on your mind?" class="w-full border border-gray-300 rounded-md p-3 text-sm"></textarea>
      <button type="submit" class="mt-3 w-full rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium">Save entry</button>
    <% end %>
  </section>

  <section class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="font-semibold mb-3">Upload audio</h2>
    <p class="text-xs text-gray-500 mb-3">Record a voice memo on your phone, then upload it here. It gets normalized and transcribed automatically -- see the README for exactly how.</p>
    <%= form_with url: audio_entries_path, method: :post, multipart: true do %>
      <input type="file" name="audio_file" accept="audio/*" required class="text-sm w-full">
      <button type="submit" class="mt-3 w-full rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium">Upload &amp; transcribe</button>
    <% end %>
  </section>

  <section class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="font-semibold mb-3">Upload video</h2>
    <p class="text-xs text-gray-500 mb-3">On a phone, this opens your camera app directly. The audio track gets extracted and transcribed the same way as a plain audio upload.</p>
    <%= form_with url: video_entries_path, method: :post, multipart: true do %>
      <input type="file" name="video_file" accept="video/*" capture="user" required class="text-sm w-full">
      <button type="submit" class="mt-3 w-full rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium">Upload &amp; transcribe</button>
    <% end %>
  </section>
</div>
