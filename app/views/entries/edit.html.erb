<% content_for :title, "Edit entry -- Soliloquy" %>

<h1 class="font-bold text-3xl mb-6">Edit entry</h1>

<%= form_with model: @entry, url: entry_path(@entry), method: :patch, class: "bg-white border border-gray-200 rounded-lg p-5 max-w-2xl" do |form| %>
  <label class="block text-sm font-medium text-gray-700 mb-1">Transcript</label>
  <%= form.text_area :transcript, rows: 8, class: "w-full border border-gray-300 rounded-md p-3 text-sm mb-4" %>

  <label class="block text-sm font-medium text-gray-700 mb-1">Tags (comma-separated)</label>
  <input type="text" name="tags" value="<%= @entry.tags.join(', ') %>" placeholder="work, family, health" class="w-full border border-gray-300 rounded-md p-3 text-sm mb-4">

  <div class="flex gap-3">
    <%= form.submit "Save changes", class: "rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", root_path, class: "rounded-md px-4 py-2 border border-gray-300 text-gray-700" %>
  </div>
<% end %>
