<% content_for :title, "Saved reports -- Soliloquy" %>

<% if alert = flash[:alert] %>
  <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg inline-block"><%= alert %></p>
<% end %>
<% if notice = flash[:notice] %>
  <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg inline-block break-all"><%= notice %></p>
<% end %>

<h1 class="font-bold text-3xl mb-2">Saved reports</h1>
<p class="text-gray-600 mb-6">A standing record, generated on request here or automatically once a month, with an optional expiring link you can hand to someone who doesn't have an account here.</p>

<p class="bg-white border border-orange-200 rounded-lg p-4 text-sm text-gray-700 mb-6">
  <span class="font-semibold text-orange-700">A small thing:</span> <%= @tip %>
</p>

<%= form_with url: reports_saved_path, method: :post, class: "bg-white border border-gray-200 rounded-lg p-4 mb-6 flex flex-wrap gap-3 items-end" do %>
  <div>
    <label class="block text-xs text-gray-500 mb-1">Days back</label>
    <input type="number" name="days" value="30" min="1" class="border border-gray-300 rounded-md px-3 py-1.5 text-sm w-24">
  </div>
  <div>
    <label class="block text-xs text-gray-500 mb-1">Audience</label>
    <select name="audience" class="border border-gray-300 rounded-md px-3 py-1.5 text-sm">
      <option value="self">Self</option>
      <option value="partner">Partner</option>
      <option value="provider">Provider</option>
    </select>
  </div>
  <button type="submit" class="rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium text-sm">Generate &amp; save</button>
<% end %>

<% if @reports.empty? %>
  <p class="text-gray-500">No saved reports yet.</p>
<% else %>
  <div class="space-y-3">
    <% @reports.each do |report| %>
      <article class="bg-white border border-gray-200 rounded-lg p-4">
        <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
          <span><%= report.created_at.strftime("%B %-d, %Y") %> -- last <%= report.days %> day(s) -- <%= report.audience %> -- <%= report.source %></span>
        </div>
        <%= form_with url: saved_report_share_link_path(report), method: :post, class: "inline" do %>
          <input type="hidden" name="expires_in_days" value="7">
          <button type="submit" class="text-xs underline text-orange-600">Create 7-day share link</button>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
