<% content_for :title, "Report -- Soliloquy" %>

<% if alert = flash[:alert] %>
  <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg inline-block"><%= alert %></p>
<% end %>

<h1 class="font-bold text-3xl mb-2">Generate a report</h1>
<p class="text-gray-600 mb-6">Choose a range and an audience -- entries only ever go into a partner/provider report if you've explicitly marked them shareable with that audience on the Entries page.</p>

<p class="bg-white border border-orange-200 rounded-lg p-4 text-sm text-gray-700 mb-6">
  <span class="font-semibold text-orange-700">A small thing:</span> <%= @tip %>
</p>

<%= form_with url: report_path, method: :post, class: "bg-white border border-gray-200 rounded-lg p-5 max-w-lg" do %>
  <label class="block text-sm font-medium text-gray-700 mb-1">Days back</label>
  <input type="number" name="days" value="7" min="1" class="w-full border border-gray-300 rounded-md p-2 mb-4">

  <label class="block text-sm font-medium text-gray-700 mb-1">Audience</label>
  <select name="audience" class="w-full border border-gray-300 rounded-md p-2 mb-4">
    <% @audiences.each do |audience| %>
      <option value="<%= audience %>"><%= audience.capitalize %></option>
    <% end %>
  </select>

  <label class="block text-sm font-medium text-gray-700 mb-1">Format</label>
  <select name="format" class="w-full border border-gray-300 rounded-md p-2 mb-4">
    <option value="text">Plain text</option>
    <option value="markdown">Markdown</option>
    <option value="html">HTML</option>
    <option value="pdf">PDF</option>
  </select>

  <button type="submit" class="rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium">Generate &amp; download</button>
<% end %>
